//simple Java program that generates a calendar for a given month and year using the java.util.Calendar class.
import java.util.Calendar;

public class CalendarExample {

    public static void main(String[] args) {
        int year = 2025;  // You can change the year
        int month = 1;    // You can change the month (January = 0, February = 1, etc.)

        printCalendar(year, month);
    }

    public static void printCalendar(int year, int month) {
        Calendar cal = Calendar.getInstance();
        cal.set(year, month, 1);

        // Print the header
        System.out.println("Sun Mon Tue Wed Thu Fri Sat");

        // Get the day of the week for the 1st day of the month
        int firstDayOfMonth = cal.get(Calendar.DAY_OF_WEEK);

        // Print leading spaces for the first row
        for (int i = 1; i < firstDayOfMonth; i++) {
            System.out.print("    "); // 4 spaces
        }

        // Get the number of days in the month
        int daysInMonth = cal.getActualMaximum(Calendar.DAY_OF_MONTH);

        // Print the days of the month
        for (int day = 1; day <= daysInMonth; day++) {
            System.out.printf("%3d ", day);

            // Move to the next line after Saturday
            if ((firstDayOfMonth + day - 1) % 7 == 0) {
                System.out.println();
            }
        }

        System.out.println();
    }
}
